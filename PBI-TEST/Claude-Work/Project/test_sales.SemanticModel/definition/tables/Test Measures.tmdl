table 'Test Measures'
	lineageTag: 32628412-59c7-4317-869c-288c02ea76bb

	/// Synthetic test measure: sum of Sales[Amount].
	measure 'Total Amount' = SUM(Sales[Amount])
		formatString: \$#,0
		lineageTag: a03603b5-1f90-4767-bf6c-f366cccb6223

	measure 'Average Sales Amount' = AVERAGE(Sales[Amount])
		formatString: \$#,0.00
		lineageTag: 37b424eb-4b7c-4527-9d41-f41e15dde958

	/// Synthetic test measure: count of rows in Sales.
	measure 'Total Sales Records' = COUNTROWS('Sales')
		formatString: #,0
		lineageTag: 6e2f9c41-8d3b-4a7e-b5c2-1f04d9a7e83b

	/// Synthetic test measure: sum of Sales[Quantity].
	measure 'Total Quantity Sold' = SUM('Sales'[Quantity])
		formatString: #,0
		lineageTag: b4e8d2a7-3c61-4f95-9a0e-7d52c1f8e346

	/// Synthetic test measure: average quantity per Sales row.
	measure 'Average Quantity per Sales Record' = DIVIDE([Total Quantity Sold], [Total Sales Records])
		formatString: 0.0
		lineageTag: d7c3a915-2e84-4b6f-8a1d-5c9e0f3b72a6

	column Dummy
		isHidden
		lineageTag: 858750a1-f765-43bf-931a-1685413370c1
		summarizeBy: none
		sourceColumn: [Dummy]

	partition 'Test Measures' = calculated
		mode: import
		source = ROW("Dummy", BLANK())

